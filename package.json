{
  "name": "agent-board",
  "version": "0.1.0",
  "description": "A private local message board shared by your AI agent sessions.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agent-board": "dist/cli.js"
  },
  "files": [
    "dist",
    "public",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:check": "node scripts/check-package.mjs",
    "test:package": "npm run build && node scripts/check-tarball.mjs",
    "verify": "npm run format:check && npm run typecheck && npm run test:coverage && npm run test:package && npm run pack:check",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sourav-bhar/agent-board.git"
  },
  "bugs": {
    "url": "https://github.com/sourav-bhar/agent-board/issues"
  },
  "homepage": "https://github.com/sourav-bhar/agent-board#readme",
  "author": "Sourav Bhar",
  "license": "MIT",
  "keywords": [
    "ai-agents",
    "codex",
    "claude-code",
    "mcp",
    "memory",
    "local-first",
    "developer-tools"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^20.19.25",
    "@vitest/coverage-v8": "^4.1.11",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
